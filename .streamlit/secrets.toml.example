# Cấu hình Secrets cho Streamlit Cloud (App settings -> Secrets)
# Hoặc copy thành secrets.toml để chạy local nếu cần

# 1. Google Gemini API Key (Bắt buộc nếu muốn phân tích Vision AI trực tiếp trên ảnh)
GEMINI_API_KEY = "AIzaSy..."

# 2. Figma Personal Access Token (Tùy chọn: Dùng nếu muốn trích xuất màn hình từ link Figma)
# Lấy từ: Figma -> Cài đặt tài khoản (Settings) -> Security -> Personal Access Tokens
FIGMA_ACCESS_TOKEN = "figd_..."

# 3. Cookies từ Google NotebookLM (Tùy chọn: Dùng nếu muốn đồng bộ trực tiếp với Notebook 'The Design of Everyday Creative Things' trên Cloud)
# Lấy từ Header Cookie của Chrome DevTools khi truy cập notebook.google.com:
# NOTEBOOKLM_COOKIES = "SID=...; HSID=...; SSID=..."
